# Frontend (safe public values only; copied into Vite at build time)
VITE_API_URL=http://localhost:8000
VITE_MIDNIGHT_NETWORK=preview
VITE_MIDNIGHT_ARTIFACT_BASE_URL=/contract-artifacts

# Netlify: set VITE_API_URL to the public HTTPS URL of the Render service.
# Contract addresses are generated by each user's browser deployment and are
# retained locally; there is no shared contract-address environment variable.

# Backend (server-only)
APP_ENV=development
API_CORS_ORIGINS=http://localhost:5173
# Render: set API_CORS_ORIGINS to the final Netlify origin (comma-separated if needed).
DATABASE_URL=sqlite+aiosqlite:///./lumen_commons.db
DATABASE_URL_UNPOOLED=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STORE_RAW_PUBLIC_REQUIREMENTS=false
